# PORT: Server port (defaults to 3000 in dev/cloud environment)
PORT=3000

# MONGODB_URI: MongoDB connection URI (Mongoose connects to this string)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager?retryWrites=true&w=majority
# If omitted or unconnectable, an in-memory auto-healing fallback is used so app works immediately.
MONGODB_URI="mongodb://localhost:27017/taskmanager"

# JWT_SECRET: Secret key for signing and verifying JWT authentication tokens
JWT_SECRET="dev_task_manager_jwt_secret_key_98234710293847"

# GEMINI_API_KEY: Optional AI assistant / task summarization key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
